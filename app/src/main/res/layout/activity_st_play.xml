<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_msgs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/layout_input_bar"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        tools:listitem="@layout/item_st_play_msg" />

    <androidx.cardview.widget.CardView
        android:id="@+id/layout_input_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <io.legado.app.lib.theme.view.ThemeEditText
                android:id="@+id/tie_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/st_play_placeholder"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minLines="1"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:textColorHint="@color/secondaryText"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_help"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_ai_pill"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:text="@string/st_play_help"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_stop"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_ai_circle"
                    android:contentDescription="@string/ai_agent_stop"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_stop_black_24dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_ai_circle"
                    android:contentDescription="@string/ai_agent_send"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_send" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
