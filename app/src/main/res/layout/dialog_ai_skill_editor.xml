<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="名称"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/tie_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="分类"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/sp_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/ai_skill_categories"
            android:minHeight="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="System Prompt (主提示词/角色)"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/tie_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Instruction (方法论 / 附加提示 / 拆书 aiPromptExtra)"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/tie_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="词汇表 (逗号、顿号、分号、换行分隔;拆书标签词库)"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/tie_vocab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tool descriptions (技能/工具描述)"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/tie_tool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="扩展配置 JSON (config)"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/tie_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <CheckBox
            android:id="@+id/cb_read_only"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="内置/只读 (不可直接编辑,请复制副本)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="取消" />

            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/tv_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="保存" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>