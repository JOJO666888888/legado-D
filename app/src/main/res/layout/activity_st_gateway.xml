<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <io.legado.app.ui.widget.text.TextInputLayout
        android:id="@+id/til_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/edit_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/st_gateway_url"
            android:inputType="textUri"
            android:maxLines="1"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
    </io.legado.app.ui.widget.text.TextInputLayout>

    <io.legado.app.ui.widget.text.TextInputLayout
        android:id="@+id/til_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/til_url">

        <io.legado.app.lib.theme.view.ThemeEditText
            android:id="@+id/edit_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/st_gateway_token"
            android:inputType="textPassword"
            android:maxLines="1"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
    </io.legado.app.ui.widget.text.TextInputLayout>

    <io.legado.app.ui.widget.text.AccentTextView
        android:id="@+id/btn_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:paddingVertical="6dp"
        android:paddingHorizontal="14dp"
        android:text="@string/st_gateway_test"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/til_token" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_sync"
        app:layout_constraintTop_toBottomOf="@+id/btn_test"
        tools:listitem="@layout/item_st_chat" />

    <io.legado.app.ui.widget.text.AccentTextView
        android:id="@+id/btn_sync"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/st_gateway_sync"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <io.legado.app.ui.widget.text.SecondaryTextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/st_gateway_empty"
        android:textColor="@color/secondaryText"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btn_sync"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_test"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
