<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/vw_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_material_sheet"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@color/btn_bg_press_2" />

        <!-- 行号区间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/breakdown_line_start"
                android:textColor="@color/secondaryText"
                android:textSize="13sp" />

            <io.legado.app.lib.theme.view.ThemeEditText
                android:id="@+id/edit_start_line"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:inputType="number"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/breakdown_line_end"
                android:textColor="@color/secondaryText"
                android:textSize="13sp" />

            <io.legado.app.lib.theme.view.ThemeEditText
                android:id="@+id/edit_end_line"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:inputType="number"
                android:maxLines="1" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/tv_import_material"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/breakdown_import_material"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 原文预览 -->
        <TextView
            android:id="@+id/tv_preview_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:text="@string/breakdown_line_preview"
            android:textColor="@color/secondaryText"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/shape_quote_bg"
            android:maxLines="3"
            android:ellipsize="end"
            android:padding="8dp"
            android:textColor="@color/secondaryText"
            android:textSize="12sp"
            tools:text="原文预览……" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp">

                <!-- 功能标签 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/breakdown_edit_info"
                    android:textColor="@color/secondaryText"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_label_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/material_tag"
                    android:textColor="@color/secondaryText"
                    android:textSize="13sp" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/flex_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    app:flexWrap="wrap" />

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp">

                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/edit_content_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="@string/breakdown_content_summary"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp">

                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/edit_rhythm_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="@string/breakdown_rhythm_note"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
                </io.legado.app.ui.widget.text.TextInputLayout>

                <io.legado.app.ui.widget.text.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp">

                    <io.legado.app.lib.theme.view.ThemeEditText
                        android:id="@+id/edit_highlights"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="@string/breakdown_highlights"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
                </io.legado.app.ui.widget.text.TextInputLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 底部操作 -->
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            app:flexWrap="wrap"
            app:justifyContent="space_between">

            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/tv_jump"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/breakdown_jump_original" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <io.legado.app.ui.widget.text.AccentTextView
                    android:id="@+id/tv_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/breakdown_delete_segment" />

                <io.legado.app.ui.widget.text.AccentTextView
                    android:id="@+id/tv_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/action_save" />
            </LinearLayout>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
</FrameLayout>